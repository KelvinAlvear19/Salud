<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>¿Cómo amaneciste?</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🐱</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&display=swap" rel="stylesheet">
<style>
/* ============ CONFIGURACIÓN ============ */
/* Edita NOMBRE y SCRIPT_URL en el <script> de abajo */

:root{
  --almohada:#F5F1F3;
  --cobija:#1F2547;
  --sueter:#E8899C;
  --sueter-suave:#FBE3E8;
  --pastilla:#FFFFFF;
  --vaso:#A9D3D8;
  --tinta:#1F2547;
  --tinta-suave:#5B6180;
  --linea:#E3DCE0;
}
@media (prefers-color-scheme: dark){
  :root{
    --almohada:#151936;
    --cobija:#F5F1F3;
    --sueter:#F09AAB;
    --sueter-suave:#3A2640;
    --pastilla:#1F2547;
    --vaso:#6FA9B0;
    --tinta:#F5F1F3;
    --tinta-suave:#B4B8CF;
    --linea:#2E3460;
  }
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{
  margin:0;
  background:var(--almohada);
  color:var(--tinta);
  font-family:"Bricolage Grotesque", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  font-size:17px;
  line-height:1.5;
  padding:env(safe-area-inset-top,0) 0 env(safe-area-inset-bottom,0);
}
.wrap{max-width:560px;margin:0 auto;padding:28px 20px 64px}

/* ---------- Hero: la foto como polaroid ---------- */
.hero{display:flex;flex-direction:column;align-items:center;text-align:center;margin-bottom:36px}
.polaroid{
  position:relative;
  background:#fff;
  padding:12px 12px 16px;
  border-radius:4px;
  box-shadow:0 18px 40px -18px rgba(31,37,71,.45), 0 2px 6px rgba(31,37,71,.12);
  transform:rotate(-2.5deg);
  width:min(100%, 380px);
  margin:18px 0 26px;
}
.polaroid img{display:block;width:100%;height:auto;border-radius:2px;aspect-ratio:647/640;object-fit:cover}
.polaroid figcaption{
  font-size:15px;color:#5B6180;margin-top:12px;font-weight:600
}
.cinta{
  position:absolute;top:-14px;left:50%;
  width:110px;height:28px;margin-left:-55px;
  background:rgba(232,137,156,.55);
  transform:rotate(3deg);
  border-radius:2px;
}
h1{
  font-size:clamp(34px, 9vw, 48px);
  line-height:1.05;
  font-weight:800;
  letter-spacing:-.02em;
  margin:0 0 8px;
}
.sub{color:var(--tinta-suave);margin:0}

/* ---------- Formulario ---------- */
.bloque{margin-bottom:28px}
.bloque h2{font-size:20px;font-weight:600;margin:0 0 12px}

.estados{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.estado{
  appearance:none;border:2px solid var(--linea);background:var(--pastilla);color:var(--tinta);
  border-radius:18px;padding:14px 12px;font:inherit;font-weight:600;cursor:pointer;
  display:flex;align-items:center;gap:10px;text-align:left;transition:border-color .15s, background .15s;
}
.estado .emo{font-size:26px;line-height:1}
.estado[aria-pressed="true"]{border-color:var(--sueter);background:var(--sueter-suave)}

.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{
  appearance:none;border:2px solid var(--linea);background:transparent;color:var(--tinta);
  border-radius:999px;padding:8px 14px;font:inherit;font-size:15px;font-weight:600;cursor:pointer;
  transition:background .15s, border-color .15s, color .15s;
}
.chip[aria-pressed="true"]{background:var(--cobija);border-color:var(--cobija);color:var(--almohada)}
.chip[aria-pressed="true"]::before{content:"✓ "}

textarea{
  width:100%;min-height:110px;resize:vertical;
  border:2px solid var(--linea);border-radius:18px;background:var(--pastilla);color:var(--tinta);
  font:inherit;padding:14px;
}
textarea:focus{outline:none;border-color:var(--sueter)}

button:focus-visible, textarea:focus-visible{outline:3px solid var(--vaso);outline-offset:2px}

.guardar{
  appearance:none;border:0;width:100%;
  background:var(--cobija);color:var(--almohada);
  font:inherit;font-weight:800;font-size:18px;
  padding:16px;border-radius:18px;cursor:pointer;
}
.guardar:disabled{opacity:.5;cursor:not-allowed}
.aviso{font-size:14px;color:var(--tinta-suave);margin:10px 2px 0;min-height:1.4em}
.aviso.ok{color:#2f8a6b}
.aviso.error{color:#c0392b}

/* ---------- Historial ---------- */
.historial{margin-top:44px;border-top:2px dashed var(--linea);padding-top:28px}
.historial-top{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:16px}
.historial h2{font-size:24px;font-weight:800;margin:0}
.recargar{appearance:none;background:none;border:0;color:var(--tinta-suave);font:inherit;font-size:14px;cursor:pointer;text-decoration:underline}
.lista{list-style:none;margin:0;padding:0;position:relative}
.lista::before{content:"";position:absolute;left:9px;top:8px;bottom:8px;width:2px;background:var(--linea)}
.item{position:relative;padding:0 0 22px 34px}
.item::before{
  content:"";position:absolute;left:2px;top:6px;width:16px;height:16px;border-radius:50%;
  background:var(--pastilla);border:3px solid var(--sueter);
}
.item time{font-size:14px;color:var(--tinta-suave);font-weight:600}
.item .est{font-weight:800;font-size:18px;margin:2px 0 6px}
.item .mini{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:6px}
.item .mini span{font-size:13px;font-weight:600;background:var(--sueter-suave);border-radius:999px;padding:3px 10px}
.item p{margin:0;color:var(--tinta)}
.vacio{color:var(--tinta-suave);background:var(--pastilla);border-radius:18px;padding:18px;text-align:center}
.modo{font-size:13px;color:var(--tinta-suave);margin-top:18px;text-align:center}

@media (prefers-reduced-motion: no-preference){
  .polaroid{animation:caer .7s cubic-bezier(.2,.8,.3,1.1) both}
  @keyframes caer{from{opacity:0;transform:translateY(-24px) rotate(-8deg)}to{opacity:1;transform:rotate(-2.5deg)}}
}
</style>
</head>
<body>
<main class="wrap">

  <header class="hero">
    <figure class="polaroid">
      <span class="cinta" aria-hidden="true"></span>
      <img src="data:image/jpeg;base64," alt="Gatito en cama con suéter rosado, pastillas y un vaso de agua">
      <figcaption>Reposo, pastillas y agua. Así vamos.</figcaption>
    </figure>
    <h1 id="titulo">¿Cómo amaneciste?</h1>
    <p class="sub">Marca cómo te sientes y guárdalo. Quien te cuida lo verá abajo.</p>
  </header>

  <section class="bloque" aria-labelledby="h-estado">
    <h2 id="h-estado">En general me siento…</h2>
    <div class="estados" id="estados">
      <button type="button" class="estado" data-v="Estoy bien" aria-pressed="false"><span class="emo">😊</span>Estoy bien</button>
      <button type="button" class="estado" data-v="Me siento mejor" aria-pressed="false"><span class="emo">🙂</span>Me siento mejor</button>
      <button type="button" class="estado" data-v="Más o menos" aria-pressed="false"><span class="emo">😐</span>Más o menos</button>
      <button type="button" class="estado" data-v="Me siento mal" aria-pressed="false"><span class="emo">🤒</span>Me siento mal</button>
    </div>
  </section>

  <section class="bloque" aria-labelledby="h-sint">
    <h2 id="h-sint">Hoy estoy…</h2>
    <div class="chips" id="chips">
      <button type="button" class="chip" aria-pressed="false">Sin vómito</button>
      <button type="button" class="chip" aria-pressed="false">Sin dolor de cabeza</button>
      <button type="button" class="chip" aria-pressed="false">Sin fiebre</button>
      <button type="button" class="chip" aria-pressed="false">Sin dolor de estómago</button>
      <button type="button" class="chip" aria-pressed="false">Comí bien</button>
      <button type="button" class="chip" aria-pressed="false">Dormí bien</button>
      <button type="button" class="chip" aria-pressed="false">Tomé la medicina</button>
    </div>
  </section>

  <section class="bloque">
    <h2><label for="desc">Cuéntame más (opcional)</label></h2>
    <textarea id="desc" maxlength="500" placeholder="Ej: en la mañana me dolía un poco la cabeza, ya después del almuerzo mejor."></textarea>
  </section>

  <button type="button" class="guardar" id="guardar" disabled>Guardar registro</button>
  <p class="aviso" id="aviso" role="status">Elige cómo te sientes para poder guardar.</p>

  <section class="historial" aria-labelledby="h-hist">
    <div class="historial-top">
      <h2 id="h-hist">Registros</h2>
      <button type="button" class="recargar" id="recargar">Actualizar</button>
    </div>
    <ul class="lista" id="lista"></ul>
    <p class="modo" id="modo"></p>
  </section>
</main>

<script>
/* ============ CONFIGURACIÓN ============ */
// Nombre de la persona (opcional). Ej: "Andrea" → "¿Cómo amaneciste, Andrea?"
const NOMBRE = "";
// Pega aquí la URL de tu Google Apps Script (termina en /exec).
// Si la dejas vacía, los registros se guardan solo en este dispositivo.
const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbzfQ5_RQcTB-CzfSnt_53RgCGRp_crnh_Z9ScHu4IZGhWt1Xtv343eAFGWost86iaPchw/exec";
/* ======================================= */

const $ = s => document.querySelector(s);
const estados = [...document.querySelectorAll('.estado')];
const chips = [...document.querySelectorAll('.chip')];
const btn = $('#guardar'), aviso = $('#aviso'), lista = $('#lista');
const EMO = {"Estoy bien":"😊","Me siento mejor":"🙂","Más o menos":"😐","Me siento mal":"🤒"};
let estadoSel = null;

if (NOMBRE) $('#titulo').textContent = `¿Cómo amaneciste, ${NOMBRE}?`;
$('#modo').textContent = SCRIPT_URL
  ? 'Los registros se guardan en Google Sheets y se ven desde cualquier dispositivo.'
  : 'Modo local: los registros solo se ven en este navegador. Conecta Google Sheets para compartirlos.';

estados.forEach(b => b.addEventListener('click', () => {
  estados.forEach(x => x.setAttribute('aria-pressed','false'));
  b.setAttribute('aria-pressed','true');
  estadoSel = b.dataset.v;
  btn.disabled = false;
  setAviso('');
}));
chips.forEach(c => c.addEventListener('click', () => {
  c.setAttribute('aria-pressed', c.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
}));

function setAviso(t, tipo=''){ aviso.textContent = t; aviso.className = 'aviso ' + tipo; }

function leerLocal(){ try { return JSON.parse(localStorage.getItem('registros-salud') || '[]'); } catch { return []; } }
function guardarLocal(r){ try { const a = leerLocal(); a.unshift(r); localStorage.setItem('registros-salud', JSON.stringify(a.slice(0,200))); } catch {} }

async function cargar(){
  lista.innerHTML = '<li class="vacio">Cargando…</li>';
  let datos = [];
  try {
    if (SCRIPT_URL) {
      const r = await fetch(SCRIPT_URL);
      datos = await r.json();
    } else {
      datos = leerLocal();
    }
    pintar(datos);
  } catch (e) {
    lista.innerHTML = '<li class="vacio">No se pudieron cargar los registros. Revisa la conexión y toca "Actualizar".</li>';
  }
}

function fechaBonita(iso){
  const d = new Date(iso);
  return d.toLocaleDateString('es-EC', {weekday:'long', day:'numeric', month:'long'}) + ', ' +
         d.toLocaleTimeString('es-EC', {hour:'2-digit', minute:'2-digit'});
}
function esc(s){ const d = document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML; }

function pintar(datos){
  if (!datos.length){
    lista.innerHTML = '<li class="vacio">Aún no hay registros. El primero aparecerá aquí.</li>';
    return;
  }
  lista.innerHTML = datos.map(r => `
    <li class="item">
      <time datetime="${esc(r.fecha)}">${esc(fechaBonita(r.fecha))}</time>
      <div class="est">${EMO[r.estado] || ''} ${esc(r.estado)}</div>
      ${r.sintomas && r.sintomas.length ? `<div class="mini">${r.sintomas.map(s => `<span>${esc(s)}</span>`).join('')}</div>` : ''}
      ${r.descripcion ? `<p>${esc(r.descripcion)}</p>` : ''}
    </li>`).join('');
}

btn.addEventListener('click', async () => {
  if (!estadoSel) return;
  const registro = {
    fecha: new Date().toISOString(),
    estado: estadoSel,
    sintomas: chips.filter(c => c.getAttribute('aria-pressed') === 'true').map(c => c.textContent),
    descripcion: $('#desc').value.trim()
  };
  btn.disabled = true; btn.textContent = 'Guardando…';
  try {
    if (SCRIPT_URL) {
      const r = await fetch(SCRIPT_URL, { method:'POST', body: JSON.stringify(registro) });
      const res = await r.json();
      if (!res.ok) throw new Error();
    } else {
      guardarLocal(registro);
    }
    setAviso('Registro guardado. ¡Que te mejores!', 'ok');
    estados.forEach(x => x.setAttribute('aria-pressed','false'));
    chips.forEach(x => x.setAttribute('aria-pressed','false'));
    $('#desc').value = ''; estadoSel = null;
    cargar();
  } catch (e) {
    setAviso('No se guardó. Revisa tu conexión e inténtalo otra vez.', 'error');
    btn.disabled = false;
  }
  btn.textContent = 'Guardar registro';
});

$('#recargar').addEventListener('click', cargar);
cargar();
</script>
</body>
</html>
